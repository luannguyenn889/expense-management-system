      "name": "TC_U1.2_01: Đăng nhập với thông tin hợp lệ",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"nguyenvana\",\n  \"password\": \"Test@123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('TC_U1.2_01: HTTP 200 OK', function() { pm.response.to.have.status(200); });", "pm.test('Đăng nhập thành công và trả về token', function() { var json = pm.response.json(); pm.expect(json.data.token).to.be.a('string'); });"] } }]
