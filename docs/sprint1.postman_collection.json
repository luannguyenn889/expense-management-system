{
  "info": {
    "name": "SPRINT 1 - EXPENSE MANAGEMENT API",
    "_postman_id": "b3e0c7a1-8d24-4f3a-9c71-e945c78a0001",
    "description": "Bộ test tự động hóa toàn bộ API Sprint 1 (Đăng ký, Đăng nhập, Quản lý ví) theo CODING_CONVENTIONS.md",
