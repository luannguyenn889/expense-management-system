        {
          "name": "1.5 Đăng nhập thành công bằng Email (Lấy JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nguyenvana@gmail.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token returned and auto-saved to environment\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(json.data.tokenType).to.eql(\"Bearer\");",
                  "    pm.environment.set(\"accessToken\", json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
