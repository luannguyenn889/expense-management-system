{
	"info": {
		"_postman_id": "c1f7a28e-8a2b-4e1b-9d4f-d09f7a93a123",
		"name": "Expense Management - Luồng Đăng Ký (CNTT46-37)",
		"description": "Bộ kiểm thử tự động API luồng Đăng ký tài khoản (US1 - CNTT46-37)\n- Hỗ trợ username, email, mật khẩu và xác nhận mật khẩu\n- Kiểm thử đầy đủ Happy Path và các trường hợp biên/ngoại lệ (400, 409)\n- Chạy được liên tục không lo trùng lặp dữ liệu nhờ biến ngẫu nhiên",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Đăng ký thành công (Happy Path)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const randomSuffix = Math.floor(Math.random() * 100000);",
							"pm.variables.set(\"dynUsername\", \"user_\" + randomSuffix);",
							"pm.variables.set(\"dynEmail\", \"user_\" + randomSuffix + \"@gmail.com\");"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Kiểm tra chuẩn ApiResponse và dữ liệu User trả về\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.code).to.eql(201);",
							"    pm.expect(jsonData.message).to.eql(\"Đăng ký thành công\");",
							"    pm.expect(jsonData.data).to.be.an(\"object\");",
							"    pm.expect(jsonData.data.userId).to.be.a(\"number\");",
							"    pm.expect(jsonData.data.username).to.eql(pm.variables.get(\"dynUsername\"));",
							"    pm.expect(jsonData.data.email).to.eql(pm.variables.get(\"dynEmail\"));",
							"    pm.expect(jsonData.data.fullName).to.eql(\"Nguyễn Văn Đăng Ký\");",
							"    pm.expect(jsonData.data.password).to.be.undefined;",
							"    pm.expect(jsonData.data.passwordHash).to.be.undefined;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"{{dynUsername}}\",\n  \"fullName\": \"Nguyễn Văn Đăng Ký\",\n  \"email\": \"{{dynEmail}}\",\n  \"password\": \"Password123@\",\n  \"confirmPassword\": \"Password123@\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/users/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"register"
					]
				},
				"description": "Đăng ký tài khoản mới hợp lệ. Tự động sinh username và email ngẫu nhiên để có thể chạy test runner liên tục."
			},
			"response": []
		},
