    {
      "name": "2. Epic 2: Quản lý Ví (US4 & US5)",
      "item": [
        {
          "name": "2.1 Tạo ví mới thành công có số dư",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletName\": \"Ví Chi Tiêu Hàng Ngày\",\n  \"balance\": 2500000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallets"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Wallet created with correct balance and owner\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.walletName).to.eql(\"Ví Chi Tiêu Hàng Ngày\");",
                  "    pm.expect(parseFloat(json.data.balance)).to.eql(2500000.00);",
                  "    pm.expect(json.data.isActive).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 Tạo ví mới không truyền số dư (Mặc định 0.00)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletName\": \"Ví Tiết Kiệm Mới\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wallets"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Balance defaults to 0.00 when omitted\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(parseFloat(json.data.balance)).to.eql(0.00);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.3 Tạo ví thất bại - Số dư âm",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
