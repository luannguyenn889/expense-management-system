                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.4 Tạo ví thất bại - Chưa đăng nhập (Không Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
