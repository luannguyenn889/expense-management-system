  "item": [
    {
      "name": "0. Health Check",
      "item": [
        {
          "name": "0.1 Kiểm tra trạng thái máy chủ",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Server health is ok\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Epic 1: Quản lý Tài khoản (US1 & US2)",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản thành công",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nguyenvana\",\n  \"fullName\": \"Nguyen Van A\",\n  \"email\": \"nguyenvana@gmail.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response wrapper conforms to ApiResponse convention\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(201);",
                  "    pm.expect(json.data.email).to.eql(\"nguyenvana@gmail.com\");",
                  "    pm.expect(json.data).to.not.have.property(\"password\");",
                  "    pm.expect(json.data).to.not.have.property(\"passwordHash\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Đăng ký thất bại - Trùng Tên đăng nhập",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nguyenvana\",\n  \"fullName\": \"Nguyen Van B\",\n  \"email\": \"nguyenvanb@gmail.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Error message is correct\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.eql(\"Tên đăng nhập đã được sử dụng\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
